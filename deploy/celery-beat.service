[Unit]
Description=SartorialEcommerce Celery beat scheduler (sartorial-Ecommerce-BE)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
User=prime
Group=www-data
WorkingDirectory=/home/prime/sartorial-Ecommerce-BE
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# DatabaseScheduler (django_celery_beat) keeps the schedule in Postgres, so no
# local schedule file is needed. --pidfile in /run avoids stale-pid issues.
RuntimeDirectory=sartorialecommerce-beat
ExecStart=/home/prime/sartorial-Ecommerce-BE/.venv/bin/celery -A config beat \
    --loglevel=info \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler \
    --pidfile=/run/sartorialecommerce-beat/beat.pid
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
