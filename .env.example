# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only. Django needs the scheme here. The deployment's own hostname
# is added automatically on Vercel, so list extra origins (custom domains, the
# storefront) here.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Allow the rotating *.vercel.app preview hostnames (previews 400 without it).
# DJANGO_ALLOW_VERCEL_PREVIEWS=0
# Defaults to on everywhere except Vercel, where the edge already serves HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=1

# --- Database (Postgres) ---------------------------------------------------
# Precedence: USE_SQLITE=1  >  DATABASE_URL  >  the discrete POSTGRES_* vars.
#
# DATABASE_URL is what managed providers hand you (Neon, Supabase, RDS...).
# Keep the provider's query string intact — for Neon, dropping ?sslmode=require
# turns into a TLS failure at runtime rather than at deploy time.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

POSTGRES_DB=idealcommerce
POSTGRES_USER=idealcommerce
POSTGRES_PASSWORD=idealcommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Seconds to reuse a DB connection. 0 (open/close per request) is correct behind
# a connection pooler such as Neon's `-pooler` host or on serverless, where a
# persistent connection gets reaped mid-idle and resurfaces as a hard error.
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10
# Optional Postgres statement timeout in ms, so one pathological query can't pin
# a worker (or a serverless instance) open for its whole duration budget.
# DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis / Celery --------------------------------------------------------
# Redis is OPTIONAL. Leave REDIS_URL empty and the app degrades deliberately:
# local-memory caching, and Celery tasks executed inline in the calling request.
# That is the only workable mode on serverless, where there is no worker process.
# When REDIS_URL is empty, CELERY_TASK_ALWAYS_EAGER is forced on regardless of
# the value below — enqueuing onto a broker that isn't there would fail the
# request that triggered it.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Run tasks inline (no worker) when true.
CELERY_TASK_ALWAYS_EAGER=false

# How long the store-settings map stays cached, in seconds. Blank means "cache
# until explicitly invalidated" with Redis, and a 30s bound without it (a
# per-process cache can't be invalidated across instances, so it must expire).
# CACHE_SETTINGS_TIMEOUT=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for the HTTP cron entry point (/api/v1/cron/run/), used where
# Celery Beat can't run. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave empty to disable the endpoint entirely (it then returns 503).
CRON_SECRET=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Set to DEBUG to log every SQL statement (noisy).
DB_LOG_LEVEL=WARNING

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth / JWT ------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Used to build password-reset links in emails, and for transactional senders.
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=no-reply@idealcommerce.test

# --- Cloudinary (product image storage/CDN) -------------------------------
# Either set CLOUDINARY_URL, or the discrete trio below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=idealcommerce/products
# Product-image backend: "cloudinary" (real) or "mock" (no network; default when
# no cloud name is set). Tests always force "mock".
CATALOG_IMAGE_BACKEND=mock

# --- FX rates provider (Phase 4) ------------------------------------------
# One of: mock | currencyapi_net | frankfurter
RATES_PROVIDER=mock
CURRENCY_API_NET_KEY=
# Default Celery Beat cadence for FX refresh (seconds); admins can also tune
# storeconfig `currency.refresh_minutes`.
CURRENCY_REFRESH_SECONDS=3600

# --- Payments --------------------------------------------------------------
# Provider: "mock" (no account) | "paystack" | "flutterwave".
PAYMENT_PROVIDER=mock
# Secret used to sign/verify MOCK webhook payloads.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_HTTP_TIMEOUT=15
# Public URL of THIS API — shown in the admin so you can copy the webhook URL
# into the provider dashboard. Use your domain (or an ngrok https URL locally).
API_PUBLIC_BASE_URL=http://localhost:8000
# Where the gateway redirects shoppers after paying ({order} = order number).
PAYMENT_RETURN_URL=http://localhost:3000/checkout/processing?order={order}
# NOTE: provider + keys below can also be managed from Admin → Payments
# (admin values override these env fallbacks).
# Paystack — keys from https://dashboard.paystack.com (Settings → API Keys).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Flutterwave — keys from https://dashboard.flutterwave.com. SECRET_HASH must
# match the "Secret hash" you set in the dashboard webhook settings.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- Notifications (Phase 9) -----------------------------------------------
# Email backend: console | zeptomail | django | memory
NOTIFICATIONS_EMAIL_BACKEND=console
# Telegram backend: console | http | memory | disabled
NOTIFICATIONS_TELEGRAM_BACKEND=console
NOTIFICATIONS_HTTP_TIMEOUT=10

# ZeptoMail (Zoho) transactional email API. NEVER commit the real token — keep it
# in your local .env only (this file is an example).
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TOKEN=

# Sender identity + branding shown in emails.
EMAIL_FROM_ADDRESS=no-reply@idealcommerce.test
EMAIL_FROM_NAME=IdealCommerce
SUPPORT_EMAIL=support@idealcommerce.test
# Absolute URL (required for email clients).
EMAIL_LOGO_URL=http://localhost:3000/logo.png

# Telegram bot. TELEGRAM_DEFAULT_CHAT_ID is the store-ops chat for new-order alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
